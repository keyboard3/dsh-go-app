{
  "name": "dsh-go-android-app",
  "version": "0.1.1",
  "description": "Build standalone Android apps from a phone with DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "bin": { "dsh-go-android-app": "./bin/dsh-go-android-app.js" },
  "files": ["lib", "bin", "cordis.patch.yml"],
  "engines": { "node": ">=24.9.0", "dsh": "0.2.2-rc.1" },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-web": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.2-rc.1"
  },
  "keywords": ["dsh-plugin", "dsh-bundle", "android", "apk"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyboard3/dsh-go-android-app.git"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
